{% comment %}
  Renders a product detail accordion.

  Accepts:
  - id: {String} unique id suffix
  - heading: {String} accordion heading
  - icon: {String} icon name
  - content: {String} HTML content
  - attributes: {String} optional block attributes

  Usage:
  {% render 'lm-accordion', id: id, heading: heading, icon: icon, content: content %}
{% endcomment %}
<div class="product__accordion accordion quick-add-hidden" {{ attributes }}>
  <details id="Details-{{ id }}">
    <summary>
      <div class="summary__title">
        {% render 'icon-accordion', icon: icon %}
        <h2 class="h4 accordion__title inline-richtext">{{ heading | escape }}</h2>
      </div>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte" id="ProductAccordion-{{ id }}">
      <div class="accordion__content-inner">
        <div class="accordion__content-body">{{ content }}</div>
      </div>
    </div>
  </details>
</div>
