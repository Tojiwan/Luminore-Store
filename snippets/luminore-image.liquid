{% comment %}Image picker first, then a selected catalog image, then a neutral placeholder.{% endcomment %}
{%- liquid
  assign media = image
  if media == blank and product != blank
    assign index = image_index | default: 0
    assign media = product.images[index] | default: product.featured_image
  endif
  assign image_loading = 'lazy'
  assign priority = 'auto'
  if eager
    assign image_loading = 'eager'
    assign priority = 'high'
  endif
  assign image_sizes = sizes | default: '(min-width: 750px) 50vw, 100vw'
  assign image_alt = media.alt | default: product.title | default: alt
-%}
{%- if media != blank -%}
  {{ media | image_url: width: 2000 | image_tag: widths: '320, 480, 640, 900, 1200, 1600, 2000', sizes: image_sizes, loading: image_loading, fetchpriority: priority, alt: image_alt, class: 'lm-image' }}
{%- else -%}
  {{ 'product-1' | placeholder_svg_tag: 'lm-image lm-placeholder' }}
{%- endif -%}
