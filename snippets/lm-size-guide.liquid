{% comment %}
  Renders the size guide opener and modal for a selected page.

  Accepts:
  - block: {Object} the lm_size_guide block

  Usage:
  {% render 'lm-size-guide', block: block %}
{% endcomment %}
{%- if block.settings.page != blank and block.settings.page.content != blank -%}
  <modal-opener
    class="product-popup-modal__opener quick-add-hidden"
    data-modal="#SizeGuideModal-{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    <button
      id="SizeGuide-{{ block.id }}"
      class="product-popup-modal__button link"
      type="button"
      aria-haspopup="dialog"
    >
      {{ 'products.product.size_guide' | t }}
    </button>
  </modal-opener>

  <modal-dialog
    id="SizeGuideModal-{{ block.id }}"
    class="product-popup-modal lm-pdp__size-guide-modal"
    {{ block.shopify_attributes }}
  >
    <div
      role="dialog"
      aria-label="{{ block.settings.page.title | escape }}"
      aria-modal="true"
      class="product-popup-modal__content"
      tabindex="-1"
    >
      <button
        id="ModalClose-{{ block.id }}"
        type="button"
        class="product-popup-modal__toggle"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
      <div class="product-popup-modal__content-info">
        <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
        {{ block.settings.page.content }}
      </div>
    </div>
  </modal-dialog>
{%- endif -%}
