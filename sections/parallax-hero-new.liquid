{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'section-parallax-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ParallaxHero-{{ section.id }} {
    position: relative;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #ParallaxHero-{{ section.id }} .parallax-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: url('{{ section.settings.image | image_url: width: 1920 }}');
    background-size: cover;
    background-position: center;
    will-change: transform;
    z-index: 0;
  }

  #ParallaxHero-{{ section.id }} .parallax-overlay {
    position: absolute;
    inset: 0;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  #ParallaxHero-{{ section.id }} .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: {{ section.settings.text_color }};
    padding: 0 1.5rem;
  }

  #ParallaxHero-{{ section.id }} .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.1;
    margin: 0 0 1.5rem 0;
    opacity: 0;
    animation: slideUpFade 1s ease-out 0.5s forwards;
  }

  #ParallaxHero-{{ section.id }} .hero-subtitle {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    letter-spacing: 0.2rem;
    text-transform: uppercase;
    margin: 0 0 2rem 0;
    opacity: 0;
    animation: slideUpFade 1s ease-out 0.75s forwards;
    color: #c9a962;
  }

  #ParallaxHero-{{ section.id }} .hero-button {
    display: inline-block;
    padding: 1rem 3rem;
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15rem;
    color: #0d0d0d;
    background: #c9a962;
    border: 1px solid #c9a962;
    text-decoration: none;
    transition: all 0.4s ease;
    opacity: 0;
    animation: slideUpFade 1s ease-out 1s forwards;
  }

  #ParallaxHero-{{ section.id }} .hero-button:hover {
    background: transparent;
    color: #c9a962;
  }

  @keyframes slideUpFade {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 768px) {
    #ParallaxHero-{{ section.id }} {
      min-height: 500px;
    }

    #ParallaxHero-{{ section.id }} .hero-title {
      font-size: clamp(2rem, 10vw, 3.5rem);
    }
  }
{%- endstyle -%}

<div class="parallax-hero" id="ParallaxHero-{{ section.id }}">
  <div class="parallax-image"></div>
  <div class="parallax-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="hero-content">
    <h1 class="hero-title">{{ section.settings.heading }}</h1>
    {% if section.settings.subtitle != blank %}
    <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    {% endif %}
    {% if section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="hero-button">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const hero = document.getElementById('ParallaxHero-{{ section.id }}');
    const image = hero.querySelector('.parallax-image');
    let ticking = false;

    function updateParallax() {
      const scrolled = window.pageYOffset;
      const heroRect = hero.getBoundingClientRect();
      const heroTop = heroRect.top;
      const heroHeight = heroRect.height;

      // Parallax effect: move background at 40% speed
      if (heroTop < heroHeight && scrolled < heroHeight) {
        const speed = 0.4;
        const yPos = (scrolled * speed);
        image.style.transform = `translateY(${yPos}px)`;
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', updateParallax);

    // Initial set
    updateParallax();
  })();
</script>

{% schema %}
{
  "name": "Parallax Jewelry Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Redefine Your Elegance"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Timeless jewelry for the modern woman"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Collection"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#0d0d0d"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Parallax Jewelry Hero"
    }
  ]
}
{% endschema %}