<script src="{{ 'prodct-slider.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} .lm-signature {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #Signature-{{ section.id }} {
    font-size: {{ section.settings.text_size_mobile }}px;
    color: {{ section.settings.header_font_color }};
  }
  #shopify-section-{{ section.id }} .lm-signature-button {
    background-color: {{ section.settings.btn_bg_background }};
    color: {{ section.settings.btn_text_color }};
    padding: 1rem 1.6rem;
    text-align: center;
  }
  @media screen and (min-width: 750px) {
    #Signature-{{ section.id }} {
      font-size: {{ section.settings.text_size_desktop }}px;
    }
  }
{% endstyle %}

<section class="page-width lm-section lm-signature" aria-labelledby="Signature-{{ section.id }}">
  <div class="lm-section-heading">
    <div>
      <p class="lm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="Signature-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    {% if section.settings.btn_text != blank %}
    <a class="lm-text-link lm-signature-button" href="{{ routes.all_products_collection_url }}"
      >{{ section.settings.btn_text | escape }} <span aria-hidden="true">↗</span></a
    >
    {% endif %}
  </div>

  <div class="swiper product-swiper"
       data-slides-desktop="{{ section.settings.slides_per_view }}"
       data-autoplay="{{ section.settings.enable_autoplay }}"
       data-autoplay-delay="{{ section.settings.autoplay_delay }}"
       data-loop="{{ section.settings.enable_loop }}">

    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% assign item = block.settings.product %}
        {% if item != blank %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <article class="lm-product">
              <a href="{{ item.url }}">
                <div class="lm-product-image">
                  {% render 'luminore-image', product: item, sizes: '(min-width: 750px) 25vw, 50vw' -%}
                  {%- unless item.available -%}
                    <span class="lm-product-badge">Sold out</span>
                  {%- endunless %}
                </div>
                <h3>{{ item.title | escape }}</h3>
                <p class="lm-product-price">
                  {% if item.price_varies %}From {% endif -%}
                  {{- item.price | money -}}
                  {%- if item.compare_at_price > item.price %}
                    {{ item.compare_at_price | money }}
                  {%- endif %}
                </p>
              </a>
            </article>
          </div>
        {% else %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <article class="lm-product">
              <div class="lm-product-image">{% render 'luminore-image', alt: 'Select a product in the theme editor' %}</div>
              <h3>Your signature piece</h3>
              <p>Select a product in the theme editor.</p>
            </article>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_navigation or section.settings.show_pagination %}
      <div class="lm-swiper-controls">
        {% if section.settings.show_navigation %}
          <button type="button" class="swiper-button-prev lm-swiper-nav" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"></button>
        {% endif %}
        {% if section.settings.show_pagination %}
          <div class="swiper-pagination lm-swiper-pagination"></div>
        {% endif %}
        {% if section.settings.show_navigation %}
          <button type="button" class="swiper-button-next lm-swiper-nav" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"></button>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Luminore signature edit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CONSIDERED PIECES. ENDLESS POSSIBILITIES." },
    { "type": "text", "id": "heading", "label": "Slider Header", "default": "The Signature Edit" },
    { "type": "range", "id": "text_size_mobile", "label": "Text Size Mobile", "min": 10, "max": 60, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "text_size_desktop", "label": "Text Size Desktop", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 48 },
    { "type": "color", "id": "header_font_color", "label": "Header Color", "default": "#000000" },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "label": "Slides per view (desktop)",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Enable loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay (ms)",
      "min": 1000,
      "max": 7000,
      "step": 500,
      "unit": "ms",
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination",
      "default": true
    },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "View All" },
    { "type": "color", "id": "btn_bg_background", "label": "Button Background Color", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_text_color", "label": "Button Text Color", "default": "#000000" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "max_blocks": 10,
  "blocks": [
    { "type": "product", "name": "Product", "settings": [{ "type": "product", "id": "product", "label": "Product" }] }
  ],
  "presets": [
    {
      "name": "Luminore signature edit",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
