<section class="lm-section lm-style" aria-labelledby="Style-{{ section.id }}">
  <div class="lm-section-heading"><div><p class="lm-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Style-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><p>{{ section.settings.text | escape }}</p></div>
  <div class="lm-style-grid">
    {% for block in section.blocks %}
      <a class="lm-style-card" href="{{ block.settings.product.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <div class="lm-style-image">{% render 'luminore-image', image: block.settings.image, product: block.settings.product, image_index: 2, alt: block.settings.title %}</div>
        <div class="lm-style-caption"><span class="lm-eyebrow">0{{ forloop.index }} / THE STYLE NOTES</span><h3>{{ block.settings.title | escape }} <span aria-hidden="true">↗</span></h3></div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Luminore style notes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NO RULES. JUST YOU." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Styled your way." },
    { "type": "text", "id": "text", "label": "Text", "default": "Layer it. Contrast it. Make it yours. An individual point of view, for every expression." }
  ],
  "max_blocks": 2,
  "blocks": [{ "type": "look", "name": "Look", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "The art of layering" },
    { "type": "image_picker", "id": "image", "label": "Campaign or on-model image" },
    { "type": "product", "id": "product", "label": "Featured product / fallback image" }
  ] }],
  "presets": [{ "name": "Luminore style notes", "blocks": [{ "type": "look" }, { "type": "look" }] }]
}
{% endschema %}
