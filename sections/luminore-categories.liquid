<section id="luminore-collections" class="lm-section lm-categories" aria-labelledby="Categories-{{ section.id }}">
  <div class="lm-section-heading">
    <div>
      <p class="lm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="Categories-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <p>
      Find the pieces<br>
      you make your own.
    </p>
  </div>
  <div class="lm-category-grid">
    {% for block in section.blocks %}
      {% assign destination = block.settings.collection.url
        | default: block.settings.link
        | default: routes.all_products_collection_url
      %}
      <a class="lm-category" href="{{ destination }}" {{ block.shopify_attributes }}>
        <div class="lm-category-image">
          {% render 'luminore-image',
            image: block.settings.image,
            product: block.settings.product,
            sizes: '(min-width: 750px) 25vw, 50vw',
            alt: block.settings.title
          %}
        </div>
        <div class="lm-category-label">
          <h3>{{ block.settings.title | escape }}</h3>
          <span aria-hidden="true">↗</span>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Luminore categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A WORLD OF POSSIBILITIES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next signature." }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Rings" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Fallback link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "product", "id": "product", "label": "Fallback product image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luminore categories",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
