{% style %}
    /* =========================
    BASE HEADER
    ========================= */
    #shopify-section-{{ section.id }} .custom-header {
        position: relative;
        width: 100%;
        z-index: 50;
        transition: all 0.3s ease;
    }

    /* FIXED STATE */
    #shopify-section-{{ section.id }} .custom-header.is-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: {{ section.settings.header_bg }};
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    /* =========================
    ROW LAYOUT
    ========================= */
    .header-top-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid rgba(0,0,0,0.06);
    }

    .header-bottom-row {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 0;
        position: relative;
    }

    /* SEARCH LOCK */
    html.custom-header-lock-scroll,
    body.custom-header-lock-scroll {
        overflow: hidden;
    }

    /* =========================
    MEGA MENU
    ========================= */

    /* Trigger wrapper */
    .mega-menu-wrapper {
        position: static;
    }

    /* Dynamic menu from navigation */
    .mega-menu {
        background-color: {{ section.settings.header_bg }};
        border-top: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 10px 20px rgba(0,0,0,0.04);
        z-index: 999;
    }

    /* Hardcoded collections menu */
    .mega-menu-panel {
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;

        background-color: {{ section.settings.header_bg }};
        border-top: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 10px 20px rgba(0,0,0,0.04);

        opacity: 0;
        visibility: hidden;
        transform: translateY(-10px);

        transition:
            opacity 0.25s ease,
            visibility 0.25s ease,
            transform 0.25s ease;

        pointer-events: none;
        z-index: 9999;

        padding: 40px 0;
    }

    /* Show mega menu on hover */
    .mega-menu-wrapper:hover .mega-menu-panel {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }

    /* Remove theme link underlines */
    .mega-menu a,
    .mega-menu-panel a {
        text-decoration: none !important;
    }

    .mega-menu a:hover,
    .mega-menu-panel a:hover {
        text-decoration: none !important;
    }

    /* Collection card hover effect */
    .mega-menu a img,
    .mega-menu-panel a img {
        transition: transform 0.3s ease;
    }

    .mega-menu a:hover img,
    .mega-menu-panel a:hover img {
        transform: scale(1.05);
    }

    /* Collection title styling */
    .mega-menu a span,
    .mega-menu-panel a span {
        text-decoration: none !important;
        color: #000;
    }

    /* Prevent clipping issues */
    .header-bottom-row,
    .mega-menu-wrapper {
        overflow: visible;
    }

    /* Improve layering above hero/banner */
    .mega-menu,
    .mega-menu-panel {
        z-index: 9999;
    }

    .mega-menu-panel a,
    .mega-menu-panel a:hover,
    .mega-menu-panel a:focus,
    .mega-menu-panel span {
        text-decoration: none !important;
    }

    .mega-menu-wrapper > a {
    padding: 8px 12px;
    border-radius: 6px;
    transition: background-color 0.2s ease;
}

    .mega-menu-wrapper:hover > a {
        background-color: {{ section.settings.header_bg }};
    }
{% endstyle %}

<script src="{{ 'custom-header.js' | asset_url }}" defer></script>

<div class="custom-header-wrapper" data-custom-header-wrapper>

    <header
        class="custom-header tw-w-full tw-z-50"
        data-custom-header
        style="background-color: {{ section.settings.header_bg }}CC; backdrop-filter: blur(10px);"
    >
        <div class="page-width">
            <!-- =========================
                ROW 1 (UTILITY HEADER)
            ========================= -->
            <div class="header-top-row">

                <!-- LEFT: SOCIALS -->
                <div class="tw-flex tw-items-center tw-justify-self-start">
                    {% render 'icon-socials-v2' %}
                </div>

                <!-- CENTER: LOGO -->
                <a href="{{ routes.root_url }}" class="tw-flex tw-items-center tw-text-black tw-no-underline tw-justify-self-center">
                    {% if section.settings.logo_image != blank %}
                        {{
                            section.settings.logo_image
                            | image_url: width: 300
                            | image_tag: class: 'tw-max-w-[140px] md:tw-max-w-[150px] md:tw-max-h-[120px]', alt: shop.name
                        }}
                    {% else %}
                        <span class="tw-text-[28px] md:tw-text-[40px] tw-font-integral tw-font-bold">
                            {{ section.settings.logo_text }}
                        </span>
                    {% endif %}
                </a>

                <!-- RIGHT: ICONS -->
                <div class="tw-flex tw-items-center tw-gap-4 tw-justify-self-end">

                    <!-- MOBILE MENU -->
                    {% if section.settings.mobile_menu != blank %}
                    <button
                        type="button"
                        class="md:tw-hidden"
                        data-mobile-menu-open
                        aria-label="Open menu"
                    >
                        {% render 'shop-co-icons', icon: 'hamburger' %}
                    </button>
                    {% endif %}

                    <!-- MOBILE SEARCH -->
                    <button
                        type="button"
                        class="md:tw-hidden"
                        data-mobile-search-toggle
                        aria-label="Search"
                    >
                        {% render 'shop-co-icons', icon: 'search-mobile' %}
                    </button>

                    <!-- CART -->
                    {% if section.settings.show_cart %}
                    <a href="{{ routes.cart_url }}" class="tw-relative">
                        {% render 'shop-co-icons', icon: 'cart' %}
                        {% if cart.item_count > 0 %}
                            <span class="tw-absolute -tw-top-2 -tw-right-2 tw-bg-black tw-text-white tw-text-[10px] tw-rounded-full tw-px-1">
                                {{ cart.item_count }}
                            </span>
                        {% endif %}
                    </a>
                    {% endif %}

                    <!-- ACCOUNT -->
                    {% if section.settings.show_account %}
                    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
                        {% render 'shop-co-icons', icon: 'account' %}
                    </a>
                    {% endif %}

                </div>

            </div>
            <!-- =========================
                ROW 2 (NAVIGATION)
            ========================= -->
            <div class="header-bottom-row">

                {% assign desktop_navigation = section.settings.desktop_menu %}

                {% if desktop_navigation != blank %}
                <nav class="tw-flex tw-items-center tw-gap-10">

                    {% for link in desktop_navigation.links %}

                        <!-- SIMPLE LINKS (Home / Contact Us) -->
                        {% if link.links == blank %}
                            <a href="{{ link.url }}" class="tw-text-black tw-no-underline hover:tw-opacity-70">
                                {{ link.title }}
                            </a>

                        {% else %}

                        <!-- COLLECTIONS DROPDOWN -->
                        <div class="tw-relative tw-group">

                            <a href="{{ link.url }}" class="tw-flex tw-items-center tw-gap-1 tw-text-black tw-no-underline">
                                {{ link.title }}
                                {% render 'shop-co-icons', icon: 'chevron-down' %}
                            </a>

                            <div class="mega-menu tw-opacity-0 tw-invisible group-hover:tw-opacity-100 group-hover:tw-visible tw-transition tw-duration-200 tw-absolute tw-left-0 tw-top-full tw-w-full tw-bg-white tw-shadow-lg tw-py-10" 
                            style="background-color: {{ section.settings.header_bg }};">

                            <div class="page-width">
                                <div class="tw-grid tw-grid-cols-4 tw-gap-6">

                                    {% for child_link in link.links limit:4 %}
                                        {% assign collection = child_link.object %}

                                        <a href="{{ child_link.url }}" class="tw-group tw-block">

                                            {% if collection and collection.image %}
                                                <div class="tw-overflow-hidden tw-rounded-lg tw-bg-gray-100">
                                                    <img
                                                        src="{{ collection.image | image_url: width: 600 }}"
                                                        class="tw-w-full tw-h-[220px] tw-object-cover tw-transition group-hover:tw-scale-105"
                                                        alt="{{ child_link.title }}"
                                                    >
                                                </div>
                                            {% else %}
                                                <div class="tw-w-full tw-h-[220px] tw-bg-gray-200 tw-rounded-lg"></div>
                                            {% endif %}

                                            <div class="tw-mt-3 tw-text-center tw-font-medium tw-text-black">
                                                {{ child_link.title }}
                                            </div>

                                        </a>
                                    {% endfor %}

                                </div>
                            </div>

                        </div>

                        </div>
                        {% endif %}
                    {% endfor %}

                    <!-- HARDCODED MEGA MENU TRIGGER -->
                    {% assign has_mega = false %}
                    {% if section.settings.mega_collection_1 != blank %}{% assign has_mega = true %}{% endif %}
                    {% if section.settings.mega_collection_2 != blank %}{% assign has_mega = true %}{% endif %}
                    {% if section.settings.mega_collection_3 != blank %}{% assign has_mega = true %}{% endif %}
                    {% if section.settings.mega_collection_4 != blank %}{% assign has_mega = true %}{% endif %}
                    {% if has_mega %}
                    <div class="mega-menu-wrapper">
                        <a href="#" class="tw-flex tw-items-center tw-text-black tw-no-underline tw-font-medium">
                            Collections
                        </a>
                        <div class="mega-menu-panel">
                            <div class="page-width">
                                <div class="tw-grid tw-grid-cols-4 tw-gap-6 tw-justify-center">
                                {% if section.settings.mega_collection_1 != blank %}
                                {% assign collection = section.settings.mega_collection_1 %}
                                <a href="{{ collection.url }}" class="tw-no-underline tw-block tw-text-center hover:tw-opacity-70 transition-opacity">
                                    {% if collection.image %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-overflow-hidden tw-bg-gray-100">
                                        <img src="{{ collection.image | image_url: width: 600 }}" class="tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-300 hover:tw-scale-105" alt="{{ collection.title }}">
                                    </div>
                                    {% else %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-bg-gray-100 tw-flex tw-items-center tw-justify-center">
                                        <span class="tw-text-gray-400 tw-text-sm">No image</span>
                                    </div>
                                    {% endif %}
                                    <span class="tw-block tw-text-black tw-font-satoshi tw-text-[14px] md:tw-text-[18px] tw-no-underline">{{ collection.title }}</span>
                                </a>
                                {% endif %}
                                {% if section.settings.mega_collection_2 != blank %}
                                {% assign collection = section.settings.mega_collection_2 %}
                                <a href="{{ collection.url }}" class="tw-no-underline tw-block tw-text-center hover:tw-opacity-70 transition-opacity">
                                    {% if collection.image %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-overflow-hidden tw-bg-gray-100">
                                        <img src="{{ collection.image | image_url: width: 600 }}" class="tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-300 hover:tw-scale-105" alt="{{ collection.title }}">
                                    </div>
                                    {% else %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-bg-gray-100 tw-flex tw-items-center tw-justify-center">
                                        <span class="tw-text-gray-400 tw-text-sm">No image</span>
                                    </div>
                                    {% endif %}
                                    <span class="tw-block tw-text-black tw-font-satoshi tw-text-[14px] md:tw-text-[18px] tw-no-underline">{{ collection.title }}</span>
                                </a>
                                {% endif %}
                                {% if section.settings.mega_collection_3 != blank %}
                                {% assign collection = section.settings.mega_collection_3 %}
                                <a href="{{ collection.url }}" class="tw-no-underline tw-block tw-text-center hover:tw-opacity-70 transition-opacity">
                                    {% if collection.image %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-overflow-hidden tw-bg-gray-100">
                                        <img src="{{ collection.image | image_url: width: 600 }}" class="tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-300 hover:tw-scale-105" alt="{{ collection.title }}">
                                    </div>
                                    {% else %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-bg-gray-100 tw-flex tw-items-center tw-justify-center">
                                        <span class="tw-text-gray-400 tw-text-sm">No image</span>
                                    </div>
                                    {% endif %}
                                    <span class="tw-block tw-text-black tw-font-satoshi tw-text-[14px] md:tw-text-[18px] tw-no-underline">{{ collection.title }}</span>
                                </a>
                                {% endif %}
                                {% if section.settings.mega_collection_4 != blank %}
                                {% assign collection = section.settings.mega_collection_4 %}
                                <a href="{{ collection.url }}" class="tw-no-underline tw-block tw-text-center hover:tw-opacity-70 transition-opacity">
                                    {% if collection.image %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-overflow-hidden tw-bg-gray-100">
                                        <img src="{{ collection.image | image_url: width: 600 }}" class="tw-w-full tw-h-full tw-object-cover tw-transition-transform tw-duration-300 hover:tw-scale-105" alt="{{ collection.title }}">
                                    </div>
                                    {% else %}
                                    <div class="tw-aspect-square tw-mb-3 tw-rounded-[8px] tw-bg-gray-100 tw-flex tw-items-center tw-justify-center">
                                        <span class="tw-text-gray-400 tw-text-sm">No image</span>
                                    </div>
                                    {% endif %}
                                    <span class="tw-block tw-text-black tw-font-satoshi tw-text-[14px] md:tw-text-[18px] tw-no-underline">{{ collection.title }}</span>
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {% endif %}
                </nav>
                {% endif %}
            </div>
        </div>
    </header>
</div>

{% schema %}
{
    "name": "Custom Header",
    "settings": [
        {
            "type": "header",
            "content": "Menu Settings",
        },
        {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo image"
        },
        {
            "type": "text",
            "id": "logo_text",
            "label": "Logo text",
            "default": "SHOP.CO"
        },
        {
            "type": "link_list",
            "id": "desktop_menu",
            "label": "Desktop menu"
        },
        {
            "type": "link_list",
            "id": "mobile_menu",
            "label": "Mobile menu"
        },
        {
            "type": "checkbox",
            "id": "show_cart",
            "label": "Show cart icon",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_account",
            "label": "Show account icon",
            "default": true
        },
        {
            "type": "color",
            "id": "header_bg",
            "label": "Header background",
            "default": "#F2F0F1"
        },
        {
            "type": "header",
            "content": "Mega Menu Collections"
        },
        {
            "type": "collection",
            "id": "mega_collection_1",
            "label": "Collection 1"
        },
        {
            "type": "collection",
            "id": "mega_collection_2",
            "label": "Collection 2"
        },
        {
            "type": "collection",
            "id": "mega_collection_3",
            "label": "Collection 3"
        },
        {
            "type": "collection",
            "id": "mega_collection_4",
            "label": "Collection 4"
        }
    ],
    "presets": [
        {
            "name": "Custom Header"
        }
    ]
}
{% endschema %}