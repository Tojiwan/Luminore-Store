{% comment %}
 - Research about the shop account or authentication. Also check for plugins or apps for this.
{% endcomment %}

{% style %}
    #shopify-section-{{ section.id }} .custom-header {
        position: relative;
        width: 100%;
        z-index: 50;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    /* FIXED STATE (when scrolling) */
    #shopify-section-{{ section.id }} .custom-header.is-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: {{ section.settings.header_bg }};
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    /* TOP STATE (when at hero section / page top) */
    #shopify-section-{{ section.id }} .custom-header.is-top {
        position: relative;
        background-color: transparent;
        box-shadow: none;
    }

    /* overlay */
    #shopify-section-{{ section.id }} .custom-header__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        z-index: 60;
    }

    #shopify-section-{{ section.id }} .custom-header__overlay.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* drawer */
    #shopify-section-{{ section.id }} .custom-header__drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: min(86vw, 340px);
        height: 100vh;
        background: #ffffff;
        transform: translateX(-100%);
        transition: transform 0.35s ease;
        z-index: 70;
        overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .custom-header__drawer.is-open {
        transform: translateX(0);
    }

    /* search panel */
    #shopify-section-{{ section.id }} .custom-header__search-panel {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transform: translateY(-10px);
        transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.35s ease;
    }

    #shopify-section-{{ section.id }} .custom-header__search-panel.is-open {
        max-height: 120px;
        opacity: 1;
        transform: translateY(0);
    }

    /* lock scroll */
    html.custom-header-lock-scroll,
    body.custom-header-lock-scroll {
        overflow: hidden;
}
{% endstyle %}

<script src="{{ 'custom-header.js' | asset_url }}" defer="defer"></script>

<div class="custom-header-wrapper" data-custom-header-wrapper>
    {% assign desktop_navigation = section.settings.desktop_menu %}
    {% assign mobile_navigation = section.settings.mobile_menu %}   
