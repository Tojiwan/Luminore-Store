{% comment %}
 - Research about the shop account or authentication. Also check for plugins or apps for this.
{% endcomment %}

{% style %}
    #shopify-section-{{ section.id }} .custom-header {
        position: relative;
        width: 100%;
        z-index: 50;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }

    /* FIXED STATE (when scrolling) */
    #shopify-section-{{ section.id }} .custom-header.is-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background-color: {{ section.settings.header_bg }};
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    /* TOP STATE (when at hero section / page top) */
    #shopify-section-{{ section.id }} .custom-header.is-top {
        position: relative;
        background-color: transparent;
        box-shadow: none;
    }

    /* overlay */
    #shopify-section-{{ section.id }} .custom-header__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.3s ease, visibility 0.3s ease;
        z-index: 60;
    }

    #shopify-section-{{ section.id }} .custom-header__overlay.is-open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* drawer */
    #shopify-section-{{ section.id }} .custom-header__drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: min(86vw, 340px);
        height: 100vh;
        background: #ffffff;
        transform: translateX(-100%);
        transition: transform 0.35s ease;
        z-index: 70;
        overflow-y: auto;
    }

    #shopify-section-{{ section.id }} .custom-header__drawer.is-open {
        transform: translateX(0);
    }

    /* search panel */
    #shopify-section-{{ section.id }} .custom-header__search-panel {
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        transform: translateY(-10px);
        transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.35s ease;
    }

    #shopify-section-{{ section.id }} .custom-header__search-panel.is-open {
        max-height: 120px;
        opacity: 1;
        transform: translateY(0);
    }

    /* lock scroll */
    html.custom-header-lock-scroll,
    body.custom-header-lock-scroll {
        overflow: hidden;
    }

    #shopify-section-{{ section.id }} input[type='search'] {
    -webkit-appearance: textfield !important;
    appearance: textfield !important;
}

    #shopify-section-{{ section.id }} input[type='search']::-webkit-search-cancel-button,
    #shopify-section-{{ section.id }} input[type='search']::-webkit-search-decoration,
    #shopify-section-{{ section.id }} input[type='search']::-webkit-search-results-button,
    #shopify-section-{{ section.id }} input[type='search']::-webkit-search-results-decoration {
        -webkit-appearance: none !important;
        appearance: none !important;
        display: none !important;
    }
{% endstyle %}

<script src="{{ 'custom-header.js' | asset_url }}" defer="defer"></script>

<div class="custom-header-wrapper" data-custom-header-wrapper>
    {% assign desktop_navigation = section.settings.desktop_menu %}
    {% assign mobile_navigation = section.settings.mobile_menu %}   
    <header
        class="custom-header tw-fixed tw-top-0 tw-left-0 tw-w-full tw-z-50 tw-border-b tw-border-black/5"
        data-custom-header
        style="background-color: {{ section.settings.header_bg }}CC; backdrop-filter: blur(10px);"
    >
        <div class="page-width">
            <div class="tw-flex tw-items-center tw-justify-between tw-gap-3 tw-py-[16px] md:tw-py-[24px]">
                <div class="tw-flex tw-items-center tw-gap-5 lg:tw-gap-10 tw-min-w-0">
                {% if mobile_navigation != blank %}
                    <button
                    type="button"
                    class="md:tw-hidden tw-inline-flex tw-h-9 tw-w-9 tw-items-center tw-justify-center tw-flex-none tw-border-0 tw-bg-transparent tw-p-0 tw-text-black tw-shadow-none tw-leading-none hover:tw-bg-transparent focus:tw-outline-none focus:tw-ring-0"
                    aria-label="Open menu"
                    aria-expanded="false"
                    data-mobile-menu-open
                    >
                        {% render 'shop-co-icons', icon: 'hamburger' %}
                    </button>
                {% endif %}

                <a href="{{ routes.root_url }}" class="tw-no-underline tw-text-black tw-shrink-0">
                    {% if section.settings.logo_image != blank %}
                    {{
                        section.settings.logo_image
                        | image_url: width: 300
                        | image_tag: class: 'tw-h-auto tw-w-auto tw-max-w-[120px] md:tw-max-w-[170px]', alt: shop.name
                    }}
                    {% else %}
                    <span class="tw-block tw-text-[24px] -tw-translate-y-2 md:-tw-translate-y-3 md:tw-text-[42px] tw-leading-none tw-font-integral tw-font-bold">
                        {{ section.settings.logo_text }}
                    </span>
                    {% endif %}
                </a>

                {% if desktop_navigation != blank %}
                    <nav class="tw-hidden lg:tw-flex tw-items-center tw-gap-8">
                    {% for link in desktop_navigation.links %}
                        <div class="tw-relative tw-group">
                        <a
                            href="{{ link.url }}"
                            class="tw-flex tw-items-center tw-gap-1 tw-text-[16px] tw-font-satoshi tw-text-black tw-no-underline hover:tw-opacity-70"
                        >
                            <span>{{ link.title }}</span>

                            {% if link.links != blank %}
                                {% render 'shop-co-icons', icon: 'chevron-down' %}
                            {% endif %}
                        </a>

                        {% if link.links != blank %}
                            <div class="tw-absolute tw-left-0 tw-top-full tw-z-20 tw-hidden tw-min-w-[220px] tw-rounded-[14px] tw-bg-white tw-py-3 tw-shadow-lg group-hover:tw-block">
                            {% for child_link in link.links %}
                                <a
                                href="{{ child_link.url }}"
                                class="tw-block tw-px-4 tw-py-2 tw-text-[14px] tw-font-satoshi tw-text-black tw-no-underline hover:tw-bg-black/5"
                                >
                                {{ child_link.title }}
                                </a>
                            {% endfor %}
                            </div>
                        {% endif %}
                        </div>
                    {% endfor %}
                    </nav>
                {% endif %}
                </div>

                <div class="tw-hidden md:tw-flex tw-flex-1 tw-justify-center tw-px-4">
                    <form action="{{ routes.search_url }}" method="get" role="search" class="tw-w-full tw-max-w-[560px]">
                        <div
                            class="tw-flex tw-items-center tw-gap-3 tw-rounded-full tw-px-[16px] tw-py-[14px]"
                            style="background-color: {{ section.settings.search_bg }};"
                            data-search-field
                        >
                            {% render 'shop-co-icons', icon: 'search-desktop' %}

                            <input
                                type="search"
                                name="q"
                                value="{{ search.terms | escape }}"
                                placeholder="{{ section.settings.search_placeholder }}"
                                class="tw-min-w-0 tw-flex-1 tw-bg-transparent tw-border-0 tw-outline-none tw-shadow-none tw-text-[14px] tw-w-[85%] placeholder:tw-text-[#9B9B9B]"
                                data-search-input
                            >

                            <button
                                type="button"
                                class="tw-hidden tw-flex-none tw-border-0 tw-bg-transparent tw-p-0 tw-text-black tw-shadow-none"
                                aria-label="Clear search"
                                data-search-clear
                            >
                                {% render 'shop-co-icons', icon: 'close' %}
                            </button>
                        </div>
                    </form>
                </div>

                <div class="tw-flex tw-items-center tw-gap-3 md:tw-gap-[14px] tw-shrink-0 md:tw-translate-y-2">
                    <button
                        type="button"
                        class="md:tw-hidden tw-inline-flex tw-h-9 tw-w-9 tw-items-center tw-justify-center tw-flex-none tw-border-0 tw-bg-transparent tw-p-0 tw-text-black tw-shadow-none tw-leading-none hover:tw-bg-transparent focus:tw-outline-none focus:tw-ring-0"
                        aria-label="Toggle search"
                        aria-expanded="false"
                        data-mobile-search-toggle
                    >
                        {% render 'shop-co-icons', icon: 'search-mobile' %}
                    </button>

                    {% if section.settings.show_cart %}
                        <a href="{{ routes.cart_url }}" class="tw-relative tw-text-black hover:tw-opacity-70" aria-label="Cart">
                            {% render 'shop-co-icons', icon: 'cart' %}

                            {% if cart.item_count > 0 %}
                                <span class="tw-absolute -tw-right-2 -tw-top-2 tw-flex tw-h-4 tw-min-w-[16px] tw-items-center tw-justify-center tw-rounded-full tw-bg-black tw-px-1 tw-text-[10px] tw-text-white">
                                {{ cart.item_count }}
                                </span>
                            {% endif %}
                        </a>
                    {% endif %}

                    {% if section.settings.show_account %}
                        <a
                        href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
                        class="tw-text-black hover:tw-opacity-70"
                        aria-label="Account"
                        >
                            {% render 'shop-co-icons', icon: 'account' %}
                        </a>
                    {% endif %}
                </div>
            </div>

            <div class="custom-header__search-panel md:tw-hidden" data-mobile-search-panel aria-hidden="true">
                <div class="tw-pb-4">
                <form action="{{ routes.search_url }}" method="get" role="search">
                    <div
                        class="tw-flex tw-items-center tw-gap-3 tw-rounded-full tw-px-[16px] tw-py-[14px]"
                        style="background-color: {{ section.settings.search_bg }};"
                        data-search-field
                    >
                        {% render 'shop-co-icons', icon: 'search-panel' %}

                        <input
                            type="search"
                            name="q"
                            value="{{ search.terms | escape }}"
                            placeholder="{{ section.settings.search_placeholder }}"
                            class="tw-min-w-0 tw-flex-1 tw-bg-transparent tw-border-0 tw-outline-none tw-shadow-none tw-w-[85%] tw-text-[14px] placeholder:tw-text-[#9B9B9B]"
                            data-search-input
                            data-mobile-search-input
                        >

                        <button
                            type="button"
                            class="tw-hidden tw-flex-none tw-border-0 tw-bg-transparent tw-p-0 tw-text-black tw-shadow-none"
                            aria-label="Clear search"
                            data-search-clear
                        >
                            {% render 'shop-co-icons', icon: 'close' %}
                        </button>
                    </div>
                </form>
                </div>
            </div>
        </div>
    </header>

    {% if mobile_navigation != blank %}
        <div class="custom-header__overlay md:tw-hidden" data-mobile-menu-overlay></div>

        <aside class="custom-header__drawer md:tw-hidden tw-rounded-r-[16px]" data-mobile-menu-drawer aria-hidden="true">
            <div class="tw-flex tw-items-center tw-justify-between tw-border-b tw-border-black/5 tw-px-5 tw-py-5 tw-bg-black">
                <span class="tw-text-[28px] tw-font-integral tw-font-regular tw-text-white -tw-translate-y-2">Menu</span>

                <button
                    type="button"
                    class="tw-inline-flex tw-h-9 tw-w-9 tw-items-center tw-justify-center tw-flex-none tw-border-0 tw-bg-transparent tw-p-0 tw-text-black tw-shadow-none tw-leading-none hover:tw-bg-transparent focus:tw-outline-none focus:tw-ring-0"
                    aria-label="Close menu"
                    data-mobile-menu-close
                >
                    {% render 'shop-co-icons', icon: 'close-white' %}
                </button>
            </div>

            <div class="tw-px-5 tw-py-4">
                <nav class="tw-flex tw-flex-col">
                {% for link in mobile_navigation.links %}
                    {% if link.links != blank %}
                    <details class="tw-border-b tw-border-black/5 tw-py-3">
                        <summary class="tw-flex tw-cursor-pointer tw-list-none tw-items-center tw-justify-between tw-gap-4 tw-rounded-[10px] tw-px-3 tw-py-3 tw-text-[16px] tw-font-medium tw-text-black {% if link.current %}tw-bg-black/5{% endif %}">
                        <span>{{ link.title }}</span>
                        {% render 'shop-co-icons', icon: 'chevron-down-lg' %}
                        </summary>

                        <div class="tw-mt-3 tw-flex tw-flex-col tw-gap-2 tw-pl-3">
                        <a
                            href="{{ link.url }}"
                            class="tw-block tw-rounded-[8px] tw-px-3 tw-py-2 tw-text-[14px] tw-font-medium tw-text-black tw-no-underline hover:tw-opacity-70 {% if link.current %}tw-bg-black/5{% endif %}"
                        >
                            View all {{ link.title }}
                        </a>

                        {% for child_link in link.links %}
                            <a
                                href="{{ child_link.url }}"
                                class="tw-block tw-rounded-[8px] tw-px-3 tw-py-2 tw-text-[14px] tw-text-black/80 tw-no-underline hover:tw-opacity-70 {% if child_link.current %}tw-bg-black/5 tw-text-black{% endif %}"
                            >
                            {{ child_link.title }}
                            </a>
                        {% endfor %}
                        </div>
                    </details>
                    {% else %}
                    <a
                        href="{{ link.url }}"
                        class="tw-block tw-rounded-[10px] tw-px-3 tw-py-4 tw-text-[16px] tw-font-medium tw-text-black tw-no-underline hover:tw-opacity-70 {% if link.current %}tw-bg-black/5{% endif %}"
                    >
                        {{ link.title }}
                    </a>
                    {% endif %}
                {% endfor %}
                </nav>
            </div>
        </aside>
    {% endif %}
</div>

{% schema %}
{
    "name": "Custom Header",
    "settings": [
        {
            "type": "image_picker",
            "id": "logo_image",
            "label": "Logo image"
        },
        {
            "type": "text",
            "id": "logo_text",
            "label": "Logo text",
            "default": "SHOP.CO"
        },
        {
            "type": "link_list",
            "id": "desktop_menu",
            "label": "Desktop / Tablet menu"
        },
        {
            "type": "link_list",
            "id": "mobile_menu",
            "label": "Mobile menu"
        },
        {
            "type": "text",
            "id": "search_placeholder",
            "label": "Search placeholder",
            "default": "Search for products..."
        },
        {
            "type": "checkbox",
            "id": "show_cart",
            "label": "Show cart icon",
            "default": true
        },
        {
            "type": "checkbox",
            "id": "show_account",
            "label": "Show account icon",
            "default": true
        },
        {
            "type": "color",
            "id": "header_bg",
            "label": "Header background",
            "default": "#F2F0F1"
        },
        {
            "type": "color",
            "id": "search_bg",
            "label": "Search background",
            "default": "#EAEAEA"
        }
    ],
    "presets": [
        {
            "name": "Custom Header"
        }
    ]
}
{% endschema %}