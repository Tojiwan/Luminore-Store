{% if section.settings.announcement != blank %}
  <div class="lm-announcement" data-announcement-key="lm-announcement-{{ section.id }}-{{ section.settings.announcement | handleize }}">
    <span class="lm-announcement__text">{{ section.settings.announcement | escape }}</span>
    <button type="button" class="lm-announcement__close" aria-label="Close announcement" data-announcement-close>
      {{- 'icon-close-small.svg' | inline_asset_content -}}
    </button>
  </div>
  <script>
    (() => {
      const bar = document.currentScript.previousElementSibling;
      if (!bar?.matches('.lm-announcement')) return;
      const key = bar.dataset.announcementKey;
      if (!window.Shopify?.designMode) {
        try {
          if (sessionStorage.getItem(key)) {
            bar.remove();
            return;
          }
        } catch {}
      }
      bar.querySelector('[data-announcement-close]')?.addEventListener('click', () => {
        if (!window.Shopify?.designMode) {
          try { sessionStorage.setItem(key, '1'); } catch {}
        }
        bar.remove();
      });
    })();
  </script>
{% endif %}
{% style %}
  #shopify-section-{{ section.id }} {
    --lm-nav-icon-color: {{ section.settings.icon_color }};
    --lm-nav-icon-size: {{ section.settings.icon_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      --lm-nav-icon-size: {{ section.settings.icon_size_desktop }}px;
    }
  }
{% endstyle %}
<header class="lm-header">
  <details class="lm-menu">
    <summary class="lm-icon-button"><span class="lm-menu-lines" aria-hidden="true"></span><span>Menu</span></summary>
    <nav class="lm-menu-panel" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">Shop all jewelry {% render 'luminore-arrow', direction: 'outcome' %}</a>
      <a href="{{ routes.collections_url }}">Collections {% render 'luminore-arrow', direction: 'outcome' %}</a>
      <a href="{{ routes.root_url }}#luminore-story">Our story {% render 'luminore-arrow', direction: 'outcome' %}</a>
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% for child in link.links -%}
          <a class="lm-menu-child" href="{{ child.url }}">{{ child.title | escape }}</a>
        {%- endfor %}
      {% endfor %}
      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="lm-header-language lm-menu-language">
          {%- form 'localization', id: 'LuminoreMenuLanguageForm', class: 'localization-form' -%}
            <span id="LuminoreMenuLanguageLabel">{{ 'localization.language_label' | t }}</span>
            {%- render 'language-localization', localPosition: 'LuminoreMenuLanguage' -%}
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </nav>
  </details>
  <nav class="lm-desktop-nav" aria-label="Main navigation">
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <a href="{{ routes.collections_url }}">Collections</a>
    <a href="{{ routes.root_url }}#luminore-story">Our story</a>
  </nav>
  <a class="lm-wordmark" href="{{ routes.root_url }}"
    >{{ section.settings.brand_text | escape }}</a
  >
  <div class="lm-header-actions">
    {%- assign icon_order = section.settings.icon_order | split: ',' -%}
    {%- for icon in icon_order -%}
      {%- case icon -%}
        {%- when 'search' -%}
          <details class="lm-search">
            <summary class="lm-icon-button" aria-label="Search jewelry">
              {% render 'luminore-icon', name: 'search' %}
            </summary>
            {%- if settings.predictive_search_enabled -%}
              <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
            {%- endif -%}
            <form class="lm-search-panel" action="{{ routes.search_url }}" method="get" role="search">
              <label for="LuminoreSearch">Find your next statement</label>
              <div class="lm-search-field">
                <input
                  id="LuminoreSearch"
                  type="search"
                  name="q"
                  placeholder="Search jewelry"
                  required
                  {% if settings.predictive_search_enabled %}
                    role="combobox"
                    aria-expanded="false"
                    aria-owns="predictive-search-results"
                    aria-controls="predictive-search-results"
                    aria-haspopup="listbox"
                    aria-autocomplete="list"
                    autocorrect="off"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                  {% endif %}
                ><button type="submit">Search {% render 'luminore-arrow', direction: 'outcome' %}</button>
              </div>
              {%- if settings.predictive_search_enabled -%}
                <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                  {% render 'predictive-search' %}
                  {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                </div>
                <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
              {%- endif -%}
            </form>
            {%- if settings.predictive_search_enabled -%}
              </predictive-search>
            {%- endif -%}
          </details>
        {%- when 'account' -%}
          {%- if shop.customer_accounts_enabled -%}
            <a
              class="lm-icon-button lm-account-link"
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              aria-label="{%- if customer -%}{{ 'customer.account_fallback' | t }}{%- else -%}{{ 'customer.log_in' | t }}{%- endif -%}"
              rel="nofollow"
            >
              {% render 'luminore-icon', name: 'account' %}
            </a>
          {%- endif -%}
        {%- when 'cart' -%}
          {% render 'cart-icon-bubble', id: 'cart-icon-bubble', icon: 'luminore' %}
      {%- endcase -%}
    {%- endfor -%}
    {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
      <localization-form class="lm-header-language lm-desktop-language">
        {%- form 'localization', id: 'LuminoreHeaderLanguageForm', class: 'localization-form' -%}
          <span class="visually-hidden" id="LuminoreHeaderLanguageLabel">{{ 'localization.language_label' | t }}</span>
          {%- render 'language-localization', localPosition: 'LuminoreHeaderLanguage', compact_label: true -%}
        {%- endform -%}
      </localization-form>
    {%- endif -%}
  </div>
</header>
<script>
  (() => {
    const header = document.querySelector('.lm-header');
    const menu = header?.querySelector('.lm-menu');
    const menuPanel = menu?.querySelector('.lm-menu-panel');
    const search = header?.querySelector('.lm-search');
    const searchBody = search?.querySelector('predictive-search, .lm-search-panel');
    if (!header || !menu || !menuPanel || !search || !searchBody) return;

    const desktop = window.matchMedia('(min-width: 990px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const menuSummary = menu.querySelector('summary');
    const language = menuPanel.querySelector('.lm-menu-language');
    const placeSearch = () => {
      const parent = desktop.matches ? search : menuPanel;
      if (searchBody.parentElement === parent) return;
      if (desktop.matches) {
        menu.open = false;
        menu.classList.remove('lm-menu-closing');
        search.append(searchBody);
      } else {
        search.open = false;
        menuPanel.insertBefore(searchBody, language);
      }
    };

    const closeMenu = () => {
      if (!menu.open || menu.classList.contains('lm-menu-closing')) return;
      if (reducedMotion.matches) {
        menu.open = false;
        return;
      }
      menu.classList.add('lm-menu-closing');
      let timer;
      const finish = (event) => {
        if (event && event.animationName !== 'lm-menu-out') return;
        clearTimeout(timer);
        menuPanel.removeEventListener('animationend', finish);
        menu.open = false;
        menu.classList.remove('lm-menu-closing');
      };
      menuPanel.addEventListener('animationend', finish);
      timer = setTimeout(finish, 500);
    };

    placeSearch();
    desktop.addEventListener('change', placeSearch);
    menuSummary.addEventListener('click', (event) => {
      if (!menu.open) return;
      event.preventDefault();
      closeMenu();
    });
    document.addEventListener('click', (event) => {
      if (!menu.open) return;
      if (!menu.contains(event.target) || event.target.closest('a')) closeMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      closeMenu();
      menuSummary.focus();
    });
  })();
</script>
{% schema %}
{
  "name": "Luminore header",
  "class": "lm-header-section",
  "settings": [
    { "type": "text", "id": "brand_text", "label": "Brand text", "default": "LUMINORE" },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Jewelry for every expression. Discover your signature."
    },
    { "type": "link_list", "id": "menu", "label": "Additional mobile menu links" },
    { "type": "checkbox", "id": "enable_language_selector", "label": "Show language selector", "default": true },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size — mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Icon size — desktop",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "select",
      "id": "icon_order",
      "label": "Icon order",
      "default": "search,account,cart",
      "options": [
        { "value": "search,account,cart", "label": "Search, Account, Cart" },
        { "value": "search,cart,account", "label": "Search, Cart, Account" },
        { "value": "account,search,cart", "label": "Account, Search, Cart" },
        { "value": "account,cart,search", "label": "Account, Cart, Search" },
        { "value": "cart,search,account", "label": "Cart, Search, Account" },
        { "value": "cart,account,search", "label": "Cart, Account, Search" }
      ]
    }
  ]
}
{% endschema %}
