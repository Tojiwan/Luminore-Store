{% if section.settings.announcement != blank %}
  <div class="lm-announcement">{{ section.settings.announcement | escape }}</div>
{% endif %}
<header class="lm-header">
  <details class="lm-menu">
    <summary class="lm-icon-button"><span class="lm-menu-lines" aria-hidden="true"></span><span>Menu</span></summary>
    <nav class="lm-menu-panel" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">Shop all jewelry <span aria-hidden="true">↗</span></a>
      <a href="{{ routes.collections_url }}">Collections <span aria-hidden="true">↗</span></a>
      <a href="{{ routes.root_url }}#luminore-story">Our story <span aria-hidden="true">↗</span></a>
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
        {% for child in link.links -%}
          <a class="lm-menu-child" href="{{ child.url }}">{{ child.title | escape }}</a>
        {%- endfor %}
      {% endfor %}
      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form class="lm-header-language lm-menu-language">
          {%- form 'localization', id: 'LuminoreMenuLanguageForm', class: 'localization-form' -%}
            <span id="LuminoreMenuLanguageLabel">{{ 'localization.language_label' | t }}</span>
            {%- render 'language-localization', localPosition: 'LuminoreMenuLanguage' -%}
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </nav>
  </details>
  <nav class="lm-desktop-nav" aria-label="Main navigation">
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    <a href="{{ routes.collections_url }}">Collections</a>
    <a href="{{ routes.root_url }}#luminore-story">Our story</a>
  </nav>
  <a class="lm-wordmark" href="{{ routes.root_url }}" aria-label="Luminore home"
    >LUMINORE</a
  >
  <div class="lm-header-actions">
    <details class="lm-search">
      <summary class="lm-icon-button" aria-label="Search jewelry">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
        </svg>
      </summary>
      {%- if settings.predictive_search_enabled -%}
        <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}
      <form class="lm-search-panel" action="{{ routes.search_url }}" method="get" role="search">
        <label for="LuminoreSearch">Find your next statement</label>
        <div class="lm-search-field">
          <input
            id="LuminoreSearch"
            type="search"
            name="q"
            placeholder="Search jewelry"
            required
            {% if settings.predictive_search_enabled %}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {% endif %}
          ><button type="submit">Search <span aria-hidden="true">↗</span></button>
        </div>
        {%- if settings.predictive_search_enabled -%}
          <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
            {% render 'predictive-search' %}
            {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
          </div>
          <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
        {%- endif -%}
      </form>
      {%- if settings.predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
    </details>
    {% render 'cart-icon-bubble', id: 'cart-icon-bubble' %}
    {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
      <localization-form class="lm-header-language lm-desktop-language">
        {%- form 'localization', id: 'LuminoreHeaderLanguageForm', class: 'localization-form' -%}
          <span class="visually-hidden" id="LuminoreHeaderLanguageLabel">{{ 'localization.language_label' | t }}</span>
          {%- render 'language-localization', localPosition: 'LuminoreHeaderLanguage', compact_label: true -%}
        {%- endform -%}
      </localization-form>
    {%- endif -%}
  </div>
</header>
{% schema %}
{
  "name": "Luminore header",
  "class": "lm-header-section",
  "settings": [
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Jewelry for every expression. Discover your signature."
    },
    { "type": "link_list", "id": "menu", "label": "Additional mobile menu links" },
    { "type": "checkbox", "id": "enable_language_selector", "label": "Show language selector", "default": true }
  ]
}
{% endschema %}
