{%- liquid
  assign items = product.metafields.custom.styled_with.value
  assign fallback_collection = product.collections.first
  if items == blank
    assign items = fallback_collection.products
  endif
  assign count = 0
-%}
{%- capture cards -%}
  {%- for item in items -%}
    {%- if item.id != product.id -%}
      <div class="swiper-slide">
        {% render 'card-product', card_product: item, media_aspect_ratio: 'portrait', show_secondary_image: true, quick_add: 'standard', section_id: section.id %}
      </div>
      {%- assign count = count | plus: 1 -%}
      {%- if count == 4 -%}{%- break -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if count > 0 -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {{ 'luminore-styled-with.css' | asset_url | stylesheet_tag }}
  {% style %}
    {% if section.settings.use_custom_font %}
      {{ section.settings.custom_font | font_face: font_display: 'swap' }}
      #shopify-section-{{ section.id }} .lm-section-heading h2,
      #shopify-section-{{ section.id }} .lm-section-heading .lm-text-link {
        font-family: {{ section.settings.custom_font.family }}, {{ section.settings.custom_font.fallback_families }};
        font-style: {{ section.settings.custom_font.style }};
        font-weight: {{ section.settings.custom_font.weight }};
      }
    {% endif %}
    #shopify-section-{{ section.id }} .lm-styled-with {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .lm-section-heading h2 {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }
    #shopify-section-{{ section.id }} .lm-section-heading .lm-text-link {
      font-size: {{ section.settings.link_size }}px;
    }
    #shopify-section-{{ section.id }} .card__heading {
      font-size: {{ section.settings.product_title_size }}px;
    }
    #shopify-section-{{ section.id }} .card-information .price {
      font-size: {{ section.settings.price_size }}px;
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .lm-section-heading h2 {
        font-size: {{ section.settings.heading_size_desktop }}px;
      }
    }
  {% endstyle %}
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer></script>
  <script src="{{ 'luminore-styled-with.js' | asset_url }}" defer></script>
  <section class="lm-section lm-styled-with" aria-labelledby="StyledWith-{{ section.id }}">
    <div class="lm-section-heading">
      <h2 id="StyledWith-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.link != blank and section.settings.link_label != blank %}
        <a class="lm-text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
    <luminore-styled-with class="swiper">
      <div class="swiper-wrapper">{{ cards }}</div>
      <div class="lm-swiper-controls">
        <div class="swiper-pagination lm-swiper-pagination" aria-live="polite" aria-atomic="true"></div>
        <div class="lm-swiper-arrows">
          <button type="button" class="swiper-button-prev lm-swiper-nav" aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}">{% render 'luminore-arrow', direction: 'left' %}</button>
          <button type="button" class="swiper-button-next lm-swiper-nav" aria-label="{{ 'sections.slideshow.next_slideshow' | t }}">{% render 'luminore-arrow', direction: 'right' %}</button>
        </div>
      </div>
    </luminore-styled-with>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Luminore styled with",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Styled with" },
    { "type": "paragraph", "content": "Uses custom.styled_with product references, or the product's first collection when empty. Displays up to four products and excludes the current product." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Optional view-all link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "header", "content": "Heading and link typography" },
    { "type": "checkbox", "id": "use_custom_font", "label": "Use custom font", "default": false, "info": "Applies only to the heading and View all link. Leave off to use the Luminore fonts." },
    { "type": "font_picker", "id": "custom_font", "label": "Custom font", "default": "assistant_n4" },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 20, "max": 64, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "heading_size_desktop", "label": "Desktop heading size", "min": 24, "max": 96, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "link_size", "label": "Link text size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "header", "content": "Product card typography" },
    { "type": "range", "id": "product_title_size", "label": "Product title size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 16 }
  ],
  "presets": [{ "name": "Luminore styled with" }]
}
{% endschema %}
